{
  "directives": {
    "repeat": "[text, count] -- expands to text * count, so the file stays readable",
    "concat": "[part, ...] -- expands to the parts joined, each part expanded first"
  },
  "requires_env": "A case may name server settings it needs, as an upper bound the server must be configured AT OR BELOW. `build-runs-for-ever` cannot be run against a default server: ZERO_BUILD_TIMEOUT_S is 7200, so the case would hold a build slot for two hours -- which is the danger it exists to describe.",
  "note": "Complete POST /execute bodies. Each is a thing a submitted runtime could do to the SERVICE rather than to itself. `session_id` is replaced per run. Every case must leave GET /health answering afterwards -- that assertion is the point of the file.",
  "route": "POST /execute",
  "expect_keys": {
    "status": "the HTTP status the gateway must answer with",
    "status_in": "any of these statuses is acceptable; the survival check is the assertion",
    "error_prefix": "the error must start with this; the prefix IS the status contract",
    "returncode_nonzero": "the action must not have succeeded",
    "timed_out": "the action must have hit timeout_s",
    "not_timed_out": "it must have died of its limit, not of the clock",
    "not_alive": "the session must have been destroyed",
    "signal": "the signal the kernel used, so the case names WHICH limit bound it",
    "max_workspace_mb": "files.bytes_used must not exceed this",
    "over_quota": "the workspace grant (bytes OR inodes) must have been found exceeded",
    "max_retained_kb": "stdout_bytes and stderr_bytes must not exceed this",
    "min_total_mb": "stdout_total_bytes must show the stream really was that large",
    "stdout_int_at_most": "stdout read as an integer must not exceed this"
  },
  "cases": [
    {
      "name": "workspace-fills-the-node",
      "danger": "workdir_gb is enforced as a per-file `fsize` ulimit, not as a quota. Files that each stay under it fill the node's compute-local scratch, and the service dies with the disk it keeps its image store and every workspace on. The grant is a CEILING here, not a barrier: the workspace is sampled and the container removed when it is passed, so the overshoot is one sampling interval of write bandwidth and no more. A true barrier needs a quota on the filesystem itself -- XFS project quota on the scratch directory -- because a bind mount takes no size from the engine.",
      "slow": true,
      "requires_env": {
        "ZERO_WORKDIR_POLL_S": 1
      },
      "request": {
        "runtime": {
          "dockerfile": "FROM docker.io/library/alpine:latest\nENV ZERO_RUNTIME_SHELL=/bin/sh\n",
          "documentation": ""
        },
        "session_id": "REPLACED-PER-RUN",
        "code": "for i in $(seq 1 8); do dd if=/dev/zero of=f$i bs=1M count=100 status=none || exit 0; done",
        "cwd": "/work",
        "timeout_s": 180,
        "wait_s": 60,
        "io_cap_kb": 200,
        "resources": {
          "cpus": 1,
          "memory_gb": 1,
          "workdir_gb": 0.25,
          "workdir_medium": "temp",
          "gpus": 0,
          "pids": 64
        }
      },
      "expect": {
        "status": 200,
        "over_quota": true,
        "not_alive": true,
        "max_workspace_mb": 1024
      }
    },
    {
      "name": "single-file-exceeds-the-grant",
      "danger": "One file larger than the grant. The `fsize` ulimit is what stops this one.",
      "slow": false,
      "requires_env": {},
      "request": {
        "runtime": {
          "dockerfile": "FROM docker.io/library/alpine:latest\nENV ZERO_RUNTIME_SHELL=/bin/sh\n",
          "documentation": ""
        },
        "session_id": "REPLACED-PER-RUN",
        "code": "dd if=/dev/zero of=fill bs=1M count=512 status=none; rc=$?; exit $rc",
        "cwd": "/work",
        "timeout_s": 120,
        "wait_s": 0,
        "io_cap_kb": 200,
        "resources": {
          "cpus": 1,
          "memory_gb": 1,
          "workdir_gb": 0.25,
          "workdir_medium": "temp",
          "gpus": 0,
          "pids": 64
        }
      },
      "expect": {
        "status": 200,
        "returncode_nonzero": true,
        "signal": 25,
        "max_workspace_mb": 300
      }
    },
    {
      "name": "inode-bomb",
      "danger": "Empty files carry no bytes, so a byte quota never sees them -- but they still consume inodes, and exhausting the filesystem's inode table fails every write on the node. The workspace ceiling counts inodes, not only bytes.",
      "slow": true,
      "requires_env": {
        "ZERO_WORKDIR_MAX_FILES": 50000,
        "ZERO_WORKDIR_POLL_S": 1
      },
      "request": {
        "runtime": {
          "dockerfile": "FROM docker.io/library/alpine:latest\nENV ZERO_RUNTIME_SHELL=/bin/sh\n",
          "documentation": ""
        },
        "session_id": "REPLACED-PER-RUN",
        "code": "i=0; while [ $i -lt 60000 ]; do : > f$i; i=$((i+1)); done; echo MADE_$i",
        "cwd": "/work",
        "timeout_s": 180,
        "wait_s": 60,
        "io_cap_kb": 200,
        "resources": {
          "cpus": 1,
          "memory_gb": 1,
          "workdir_gb": 0.25,
          "workdir_medium": "temp",
          "gpus": 0,
          "pids": 64
        }
      },
      "expect": {
        "status": 200,
        "over_quota": true,
        "not_alive": true
      }
    },
    {
      "name": "ram-workspace-must-be-charged-to-memory",
      "danger": "A tmpfs workspace IS memory. If workdir_gb were not added to the container's memory limit, filling it would be a node-wide memory attack that the session's own --memory never sees.",
